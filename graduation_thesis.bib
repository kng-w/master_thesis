@article{peinado_evaluation_2006,
	title = {Evaluation of automatic generation of basic stories},
	volume = {24},
	issn = {0288-3635, 1882-7055},
	url = {http://link.springer.com/10.1007/BF03037336},
	doi = {10.1007/BF03037336},
	abstract = {This paper presents an application that automatically generates basic stories: short texts that only narrate the main events of the plot. The system operates with a representation in Description Logics, combining stored fabulas with the narrative knowledge implemented in a domain-speciﬁc ontology. The domain of application is the traditional folk tale, using the well-known morphology of Vladimir Propp as narratological background. In order to evaluate the results, human judges blindly compared one of the generated basic stories to two alternatives: one rendered directly from a stored fabula of the knowledge base and another randomly generated. As a conclusion, possibilities of measuring the utility of the system in terms of quality and originality of the generated artifact are discussed.},
	pages = {289--302},
	number = {3},
	journaltitle = {New Generation Computing},
	shortjournal = {New Gener Comput},
