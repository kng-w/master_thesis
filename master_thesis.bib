@inproceedings{li_zero-shot_2024-1,
  address   = {New York, NY, USA},
  series    = {{MM} '24},
  title     = {Zero-{Shot} {Character} {Identification} and {Speaker} {Prediction} in {Comics} via {Iterative} {Multimodal} {Fusion}},
