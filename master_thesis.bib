  file      = {arXiv Fulltext PDF:/Users/kengowatanabe/Zotero/storage/ZU3Z6HDU/Esser et al. - 2024 - Scaling Rectified Flow Transformers for High-Resol.pdf:application/pdf;arXiv.org Snapshot:/Users/kengowatanabe/Zotero/storage/I3WSK2GT/2403.html:text/html}
