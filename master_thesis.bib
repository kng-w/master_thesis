  file       = {arXiv Fulltext PDF(読解メモ付きはこちら):/Users/kengowatanabe/Zotero/storage/DMF7U3D4/Sachdeva and Zisserman - 2024 - The Manga Whisperer Automatically Generating Tran.pdf:application/pdf;arXiv.org Snapshot:/Users/kengowatanabe/Zotero/storage/9RRACGE4/2401.html:text/html}
