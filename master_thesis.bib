  keywords   = {Computer Science - Artificial Intelligence, Computer Science - Computation and Language, Computer Science - Machine Learning, Computer Science - Computer Vision and Pattern Recognition},
  file       = {arXiv Fulltext PDF:/Users/kengowatanabe/Zotero/storage/IETDUS5P/Wang et al. - 2024 - Mementos A Comprehensive Benchmark for Multimodal.pdf:application/pdf;arXiv.org Snapshot:/Users/kengowatanabe/Zotero/storage/8JAICRVY/2401.html:text/html}
