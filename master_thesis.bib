  keywords   = {Computer Science - Computation and Language, Computer Science - Computer Vision and Pattern Recognition},
  file       = {arXiv Fulltext PDF:/Users/kengowatanabe/Zotero/storage/P6JVKYQ3/Hessel et al. - 2022 - CLIPScore A Reference-free Evaluation Metric for .pdf:application/pdf;arXiv.org Snapshot:/Users/kengowatanabe/Zotero/storage/8SXE82S9/2104.html:text/html}
