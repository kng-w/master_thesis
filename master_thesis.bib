  pages      = {5642--5665},
  file       = {Full Text PDF:/Users/kengowatanabe/Zotero/storage/MY476B5K/Zhang と Zuo - 2025 - GRPO-LEAD A Difficulty-Aware Reinforcement Learning Approach for Concise Mathematical Reasoning in.pdf:application/pdf}
