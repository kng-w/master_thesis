  year      = {2021},
  pages     = {218--226},
  file      = {報告したバージョン:/Users/kengowatanabe/Zotero/storage/H55YNDG9/Nguyen et al. - 2021 - Diverse Multimedia Layout Generation with Multi Ch.pdf:application/pdf}
}

