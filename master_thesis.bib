  file       = {Full Text PDF:/Users/kengowatanabe/Zotero/storage/YSDS7S62/Bartoldson et al. - 2025 - Trajectory Balance with Asynchrony Decoupling Exploration and Learning for Fast, Scalable LLM Post-.pdf:application/pdf}
}

@inproceedings{zhang_grpo-lead_2025,
  address    = {Suzhou, China},
  title      = {{GRPO}-{LEAD}: {A} {Difficulty}-{Aware} {Reinforcement} {Learning} {Approach} for {Concise} {Mathematical} {Reasoning} in {Language} {Models}},
