  note      = {arXiv:2205.10747 [cs]},
  keywords  = {Computer Science - Artificial Intelligence, Computer Science - Computer Vision and Pattern Recognition},
  file      = {arXiv Fulltext PDF:/Users/kengowatanabe/Zotero/storage/6Z43V7UI/Wang et al. - 2022 - Language Models with Image Descriptors are Strong .pdf:application/pdf;arXiv.org Snapshot:/Users/kengowatanabe/Zotero/storage/3P2SWU7B/2205.html:text/html}
