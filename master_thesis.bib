@misc{yang_vidchapters-7m_2023,
  title      = {{VidChapters}-{7M}: {Video} {Chapters} at {Scale}},
  shorttitle = {{VidChapters}-{7M}},
  url        = {http://arxiv.org/abs/2309.13952},
  doi        = {10.48550/arXiv.2309.13952},
  abstract   = {Segmenting long videos into chapters enables users to quickly navigate to the information of their interest. This important topic has been understudied due to the lack of publicly released datasets. To address this issue, we present VidChapters-7M, a dataset of 817K user-chaptered videos including 7M chapters in total. VidChapters-7M is automatically created from videos online in a scalable manner by scraping user-annotated chapters and hence without any additional manual annotation. We introduce the following three tasks based on this data. First, the video chapter generation task consists of temporally segmenting the video and generating a chapter title for each segment. To further dissect the problem, we also define two variants of this task: video chapter generation given ground-truth boundaries, which requires generating a chapter title given an annotated video segment, and video chapter grounding, which requires temporally localizing a chapter given its annotated title. We benchmark both simple baselines and state-of-the-art video-language models for these three tasks. We also show that pretraining on VidChapters-7M transfers well to dense video captioning tasks in both zero-shot and finetuning settings, largely improving the state of the art on the YouCook2 and ViTT benchmarks. Finally, our experiments reveal that downstream performance scales well with the size of the pretraining dataset. Our dataset, code, and models are publicly available at https://antoyang.github.io/vidchapters.html.},
  urldate    = {2024-03-09},
  publisher  = {arXiv},
  author     = {Yang, Antoine and Nagrani, Arsha and Laptev, Ivan and Sivic, Josef and Schmid, Cordelia},
  month      = sep,
  year       = {2023},
  note       = {arXiv:2309.13952 [cs]},
  keywords   = {Computer Science - Artificial Intelligence, Computer Science - Computation and Language, Computer Science - Machine Learning, Computer Science - Computer Vision and Pattern Recognition},
  file       = {al-VidChapters-7MVideoChaptersatScale.pdf:/Users/kengowatanabe/Zotero/storage/6P29AFIA/al-VidChapters-7MVideoChaptersatScale.pdf:application/pdf;arXiv Fulltext PDF:/Users/kengowatanabe/Zotero/storage/WIFI3VJ6/Yang et al. - 2023 - VidChapters-7M Video Chapters at Scale.pdf:application/pdf;arXiv.org Snapshot:/Users/kengowatanabe/Zotero/storage/RQP2FXG9/2309.html:text/html;ja-VidChapters-7MVideoChaptersatScale.pdf:/Users/kengowatanabe/Zotero/storage/WGJ7SEDA/ja-VidChapters-7MVideoChaptersatScale.pdf:application/pdf}
}

@inproceedings{shtedritski_what_2023,
  address    = {Paris, France},
  title      = {What does {CLIP} know about a red circle? {Visual} prompt engineering for {VLMs}},
  copyright  = {https://doi.org/10.15223/policy-029},
  isbn       = {979-8-3503-0718-4},
  shorttitle = {What does {CLIP} know about a red circle?},
  url        = {https://ieeexplore.ieee.org/document/10376723/},
  doi        = {10.1109/ICCV51070.2023.01101},
  abstract   = {Large-scale Vision-Language Models, such as CLIP, learn powerful image-text representations that have found numerous applications, from zero-shot classification to textto-image generation. Despite that, their capabilities for solving novel discriminative tasks via prompting fall behind those of large language models, such as GPT-3. Here we explore the idea of visual prompt engineering for solving computer vision tasks beyond classification by editing in image space instead of text. In particular, we discover an emergent ability of CLIP, where, by simply drawing a red circle around an object, we can direct the model’s attention to that region, while also maintaining global information. We show the power of this simple approach by achieving stateof-the-art in zero-shot referring expressions comprehension and strong performance in keypoint localization tasks. Finally, we draw attention to some potential ethical concerns of large language-vision models.},
  language   = {en},
  urldate    = {2024-04-19},
  booktitle  = {2023 {IEEE}/{CVF} {International} {Conference} on {Computer} {Vision} ({ICCV})},
  publisher  = {IEEE},
  author     = {Shtedritski, Aleksandar and Rupprecht, Christian and Vedaldi, Andrea},
  month      = oct,
  year       = {2023},
  pages      = {11953--11963},
  file       = {al-What des CLIP know about a red circle Visual prompt engineering for VLMs.pdf:/Users/kengowatanabe/Zotero/storage/YLEJE5G4/al-What des CLIP know about a red circle Visual prompt engineering for VLMs.pdf:application/pdf;ja-WhatdoesCLIPknowaboutaredcircleVisualpro.pdf:/Users/kengowatanabe/Zotero/storage/PQEZNIEY/ja-WhatdoesCLIPknowaboutaredcircleVisualpro.pdf:application/pdf;What_does_CLIP_know_about_a_red_circle_Visual_prompt_ICCV_2023_paper.pdf:/Users/kengowatanabe/Zotero/storage/T6B6AQIA/What_does_CLIP_know_about_a_red_circle_Visual_prompt_ICCV_2023_paper.pdf:application/pdf}
