  author    = {Lu, Jinghui and Yu, Haiyang and Wang, Yanjie and Ye, Yongjie and Tang, Jingqun and Yang, Ziwei and Wu, Binghong and Liu, Qi and Feng, Hao and Wang, Han and Liu, Hao and Huang, Can},
  editor    = {Che, Wanxiang and Nabende, Joyce and Shutova, Ekaterina and Pilehvar, Mohammad Taher},
  month     = jul,
  year      = {2025},
  pages     = {7252--7273},
  file      = {Full Text PDF:/Users/kengowatanabe/Zotero/storage/DMSC8RR5/Lu et al. - 2025 - A Bounding Box is Worth One Token - Interleaving Layout and Text in a Large Language Model for Docum.pdf:application/pdf}
