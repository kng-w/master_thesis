  keywords  = {Computer Science - Machine Learning, Computer Science - Computer Vision and Pattern Recognition},
  file      = {arXiv Fulltext PDF:/Users/kengowatanabe/Zotero/storage/3JEVJB7N/Radford et al. - 2021 - Learning Transferable Visual Models From Natural L.pdf:application/pdf;arXiv.org Snapshot:/Users/kengowatanabe/Zotero/storage/6NEW7M85/2103.html:text/html}
