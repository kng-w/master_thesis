	author = {Wang, Zhenhailong and Li, Manling and Xu, Ruochen and Zhou, Luowei and Lei, Jie and Lin, Xudong and Wang, Shuohang and Yang, Ziyi and Zhu, Chenguang and Hoiem, Derek and Chang, Shih-Fu and Bansal, Mohit and Ji, Heng},
	month = oct,
