	keywords = {Computer Science - Computer Vision and Pattern Recognition},
	file = {Preprint PDF:/Users/kengowatanabe/Zotero/storage/SVEMTYM5/Jiang et al. - 2023 - LayoutFormer++ Conditional Graphic Layout Generat.pdf:application/pdf;Snapshot:/Users/kengowatanabe/Zotero/storage/4JKA982J/2208.html:text/html},
}
