	keywords = {Computer Science - Artificial Intelligence, Computer Science - Computer Vision and Pattern Recognition},
	file = {Preprint PDF:/Users/kengowatanabe/Zotero/storage/HZGB98HT/Wang et al. - 2024 - SCO-VIST Social Interaction Commonsense Knowledge.pdf:application/pdf;Snapshot:/Users/kengowatanabe/Zotero/storage/VY2UKEM3/2402.html:text/html},
}

@article{hsu_knowledge-enriched_2020,
