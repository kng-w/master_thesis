	note = {arXiv:2501.02189 [cs]},
	keywords = {Computer Science - Artificial Intelligence, Computer Science - Computation and Language, Computer Science - Machine Learning, Computer Science - Computer Vision and Pattern Recognition, Computer Science - Robotics},
	file = {Preprint PDF:/Users/kengowatanabe/Zotero/storage/MXBQ6CIJ/Li et al. - 2025 - Benchmark Evaluations, Applications, and Challenge.pdf:application/pdf;Snapshot:/Users/kengowatanabe/Zotero/storage/RILLPTX8/2501.html:text/html},
