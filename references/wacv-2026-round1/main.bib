	pages = {101940},
	file = {ScienceDirect Snapshot:/Users/kengowatanabe/Zotero/storage/N4332GJC/S1566253523002567.html:text/html},
}

@article{shi_understanding_2023,
	title = {Understanding {Design} {Collaboration} {Between} {Designers} and {Artificial} {Intelligence}: {A} {Systematic} {Literature} {Review}},
