@misc{malakan_sequential_2023,
	title = {Sequential {Storytelling} {Image} {Dataset} ({SSID})},
	url = {https://ieee-dataport.org/documents/sequential-storytelling-image-dataset-ssid},
	abstract = {Visual storytelling refers to the manner of describing a set of images rather than a single image, also known as multi-image captioning. Visual Storytelling Task (VST) takes a set of images as input and aims to generate a coherent story relevant to the input images. In this dataset, we bridge the gap and present a new dataset for expressive and coherent story creation. We present the Sequential Storytelling Image Dataset (SSID), consisting of open-source video frames accompanied by story-like annotations. In addition, we provide four annotations (i.e., stories) for each set of five images.},
	language = {en},
	urldate = {2025-02-08},
	publisher = {IEEE},
	author = {Malakan, Zainy},
	month = may,
	year = {2023},
	file = {Snapshot:files/1266/sequential-storytelling-image-dataset-ssid.html:text/html},
}

